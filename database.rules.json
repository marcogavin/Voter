{
  "rules": {
    "events": {
      "$eventId": {
        "ownerUid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString()"
        },
        "currentDeck": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "currentIndex": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        },
        "currentQuestionKey": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isString() || newData.val() === null"
        },
        "revealed": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isBoolean()"
        },
        "askedAt": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        },
        "pausedAt": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        },
        "seconds": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
        },
        "blanked": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isBoolean()"
        },
        "lang": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null && newData.val() === null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          "$playerUid": {
            ".write": "auth != null && $playerUid === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          }
        },
        "seen": {
          ".read": "auth != null",
          ".write": "auth != null && newData.val() === null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          "$playerUid": {
            ".write": "auth != null && $playerUid === auth.uid",
            ".validate": "newData.isNumber()"
          }
        },
        "decks": {
          ".read": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          "$deckId": {
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "createdAt": { ".validate": "newData.isNumber()" },
            "lastRunAt": { ".validate": "newData.isNumber()" },
            "questionCount": {
              ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val()",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "likes": {
              ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val()",
              ".write": "auth != null && newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "questions": {
              "$questionId": {
                "text": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && $questionId === root.child('events').child($eventId).child('currentQuestionKey').val()",
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                },
                "correct": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && (root.child('events').child($eventId).child('currentIndex').val() >= root.child('events').child($eventId).child('decks').child($deckId).child('questionCount').val() || ($questionId === root.child('events').child($eventId).child('currentQuestionKey').val() && root.child('events').child($eventId).child('revealed').val() === true))",
                  ".validate": "newData.isString() && newData.val().length <= 4"
                },
                "options": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && $questionId === root.child('events').child($eventId).child('currentQuestionKey').val()",
                  "$optionId": {
                    "label": {
                      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                    },
                    "votes": {
                      ".write": "auth != null && data.exists() && newData.isNumber() && newData.val() === data.val() + 1 && root.child('events').child($eventId).child('revealed').val() !== true",
                      ".validate": "newData.isNumber() && newData.val() >= 0"
                    },
                    "$otherField": {
                      ".validate": false
                    }
                  }
                },
                "voters": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && ($questionId === root.child('events').child($eventId).child('currentQuestionKey').val() || root.child('events').child($eventId).child('currentIndex').val() >= root.child('events').child($eventId).child('decks').child($deckId).child('questionCount').val())",
                  "$voterUid": {
                    ".write": "auth != null && $voterUid === auth.uid && !data.exists() && root.child('events').child($eventId).child('revealed').val() !== true",
                    ".validate": "newData.isString() && newData.val().length <= 4"
                  }
                },
                "times": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && ($questionId === root.child('events').child($eventId).child('currentQuestionKey').val() || root.child('events').child($eventId).child('currentIndex').val() >= root.child('events').child($eventId).child('decks').child($deckId).child('questionCount').val())",
                  "$voterUid": {
                    ".write": "auth != null && $voterUid === auth.uid && !data.exists() && root.child('events').child($eventId).child('revealed').val() !== true",
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000"
                  }
                },
                "ratingStars": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && $questionId === root.child('events').child($eventId).child('currentQuestionKey').val()",
                  ".validate": "newData.isNumber() && (newData.val() === 3 || newData.val() === 5 || newData.val() === 10)"
                },
                "ratingColor": {
                  ".read": "auth != null && $deckId === root.child('events').child($eventId).child('currentDeck').val() && $questionId === root.child('events').child($eventId).child('currentQuestionKey').val()",
                  ".validate": "newData.isString() && (newData.val() === 'gold' || newData.val() === 'red' || newData.val() === 'green' || newData.val() === 'blue' || newData.val() === 'purple')"
                },
                "$otherField": {
                  ".validate": false
                }
              }
            },
            "$otherField": {
              ".validate": false
            }
          }
        },
        "questions": {
          ".read": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          "$questionId": {
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "correct": {
              ".validate": "newData.isString() && newData.val().length <= 4"
            },
            "options": {
              "$optionId": {
                "label": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                },
                "votes": {
                  ".write": "auth != null && data.exists() && newData.isNumber() && newData.val() === data.val() + 1 && root.child('events').child($eventId).child('revealed').val() !== true",
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "$otherField": {
                  ".validate": false
                }
              }
            },
            "voters": {
              "$voterUid": {
                ".write": "auth != null && $voterUid === auth.uid && !data.exists() && root.child('events').child($eventId).child('revealed').val() !== true",
                ".validate": "newData.isString() && newData.val().length <= 4"
              }
            },
            "times": {
              "$voterUid": {
                ".write": "auth != null && $voterUid === auth.uid && !data.exists() && root.child('events').child($eventId).child('revealed').val() !== true",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000"
              }
            },
            "ratingStars": {
              ".validate": "newData.isNumber() && (newData.val() === 3 || newData.val() === 5 || newData.val() === 10)"
            },
            "ratingColor": {
              ".validate": "newData.isString() && (newData.val() === 'gold' || newData.val() === 'red' || newData.val() === 'green' || newData.val() === 'blue' || newData.val() === 'purple')"
            },
            "$otherField": {
              ".validate": false
            }
          }
        },
        "$otherField": {
          ".validate": false
        }
      }
    }
  }
}
