{
  "rules": {
    "events": {
      "$eventId": {
        ".read": "auth != null",

        "ownerUid": {
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString()"
        },

        "currentIndex": {
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        },

        "questions": {
          ".write": "auth != null && (!data.parent().child('ownerUid').exists() || data.parent().child('ownerUid').val() === auth.uid)",

          "$questionId": {
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },

            "options": {
              "$optionId": {
                "label": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                },
                "votes": {
                  ".write": "auth != null && data.exists() && newData.isNumber() && newData.val() === data.val() + 1",
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "$otherField": {
                  ".validate": false
                }
              }
            },

            "voters": {
              "$voterUid": {
                ".write": "auth != null && $voterUid === auth.uid && !data.exists()",
                ".validate": "newData.isString() && root.child('events').child($eventId).child('questions').child($questionId).child('options').child(newData.val()).exists()"
              }
            },

            "$otherField": {
              ".validate": false
            }
          }
        },

        "$otherField": {
          ".validate": false
        }
      }
    }
  }
}
